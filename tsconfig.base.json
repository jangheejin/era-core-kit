{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      //      "@kit/schema": ["packages/schema/src", "packages/schema/dist"],
      "@kit/schema": ["packages/schema/src"],
      //      "@kit/blocks": ["packages/blocks/src", "packages/blocks/dist"],
      "@kit/blocks": ["packages/blocks/src"],
      //      "@kit/cms-contract": ["packages/cms-contract/src", "packages/cms-contract/dist"],
      "@kit/cms-contract": ["packages/cms-contract/src"]
    },
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",

    "lib": ["DOM", "DOM.Iterable", "ESNext"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,

    //    "allowJs": true,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["react", "react-dom", "node"]
    //"types": ["node"]
  }
}
